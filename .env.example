# ===== Threads (Meta) =====
# READMEの手順で取得する長期トークン（60日有効・自動更新される）
THREADS_ACCESS_TOKEN=
# /me から取得して入れる。空ならクライアントが自動取得する
THREADS_USER_ID=

# ===== Claude (Anthropic) =====
# 投稿文・返信文の生成に使用
ANTHROPIC_API_KEY=

# ===== Chatwork（手挙げリード通知）=====
CHATWORK_API_TOKEN=
CHATWORK_ROOM_ID=

# ===== 保存先バックエンド =====
# sqlite（既定・ローカル） / sheets（ホスティング時の共有ストア）
STORE_BACKEND=sqlite

# ===== Google Sheets（STORE_BACKEND=sheets のとき必須）=====
# サービスアカウントJSONの「ファイルパス」または「JSON文字列」
GOOGLE_SERVICE_ACCOUNT_JSON=
# スプレッドシートのキー（URLの /d/<KEY>/edit の <KEY> 部分）
GOOGLE_SHEET_KEY=

# ===== ダッシュボードのログインパスワード（ホスティング時は必ず設定）=====
APP_PASSWORD=

# ===== LINE Messaging API（AI自動返信ボット）=====
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 0にするとボット停止（Webhookは200を返すだけ）
LINE_BOT_ENABLED=1
